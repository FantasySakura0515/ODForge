# Copy to .env for local development. Never commit the populated .env file.

# Required when ODFORGE_BACKEND=deepseek.
DEEPSEEK_API_KEY=

# Text generation: deepseek, ollama, or custom.
ODFORGE_BACKEND=deepseek
# ODFORGE_MODEL=deepseek-chat
# ODFORGE_DISCOVERY_MODEL=deepseek-chat
# ODFORGE_OUTLINE_MODEL=deepseek-chat
# ODFORGE_SLIDES_MODEL=deepseek-chat
# ODFORGE_OLLAMA_MODEL=qwen2.5
# ODFORGE_OLLAMA_DISCOVERY_MODEL=qwen2.5
# ODFORGE_OLLAMA_OUTLINE_MODEL=qwen2.5
# ODFORGE_OLLAMA_SLIDES_MODEL=qwen2.5
# ODFORGE_CUSTOM_BASE_URL=https://your-openai-compatible-endpoint/v1
# ODFORGE_CUSTOM_API_KEY=
# ODFORGE_CUSTOM_MODEL=
# ODFORGE_CUSTOM_DISCOVERY_MODEL=
# ODFORGE_CUSTOM_OUTLINE_MODEL=
# ODFORGE_CUSTOM_SLIDES_MODEL=
# Provider-specific fields added to each Chat Completions request.
# Qwen 3.7 function calling example:
# ODFORGE_CUSTOM_EXTRA_BODY={"enable_thinking":false}
# ODFORGE_MAX_TOKENS=8192

# Optional persistent session directory. Defaults to the user's local
# application-data folder (for example %LOCALAPPDATA%\ODForge\sessions).
# ODFORGE_SESSIONS_DIR=

# Optional image generation adapter. The endpoint receives
# {"prompt":"..."} and must return raw PNG/JPEG bytes.
ODFORGE_IMAGE_BACKEND=off
# ODFORGE_IMAGE_ENDPOINT=https://your-image-adapter/generate
# ODFORGE_IMAGE_API_KEY=

# Model-proposed remote images are disabled unless their exact HTTPS host is
# allowlisted here. Private/loopback/link-local addresses remain blocked.
# ODFORGE_REMOTE_IMAGE_HOSTS=images.example.com,cdn.example.org

# Visual QA (the fourth gate): off, ollama, claude, or custom. Leaving this at
# `off` makes the design gate a no-op — it still renders the pages, but nothing
# ever looks at them, so it always reports zero findings.
ODFORGE_VISION_BACKEND=off
# ANTHROPIC_API_KEY=
# ODFORGE_VISION_MODEL=claude-sonnet-4-5-20250929
# ODFORGE_OLLAMA_VISION_MODEL=qwen2.5vl
# `custom` reuses ODFORGE_CUSTOM_BASE_URL / _API_KEY above, so one provider
# serves both text and vision; only the model must be named. It must accept a
# forced tool_choice — DashScope's qwen3-vl-plus does, qwen-vl-max returns 400.
# ODFORGE_CUSTOM_VISION_MODEL=qwen3-vl-plus
# Only when the vision deployment lives on another host/key:
# ODFORGE_CUSTOM_VISION_BASE_URL=
# ODFORGE_CUSTOM_VISION_API_KEY=

# Browser origins only; comma-separated explicit http(s) origins.
# Wildcards, null, scheme-less values, paths, queries, and fragments are rejected.
# ODFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
